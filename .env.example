# =============================================================================
# Chọn 1 trong các provider bên dưới (chỉ cần set đúng là được)
# get_llm() sẽ tự detect provider dựa trên env vars
# Thứ tự ưu tiên: ANTHROPIC > OPENAI > LLM_* (generic) > OPENROUTER
# =============================================================================

# --- Tuỳ chọn 1: Generic OpenAI-compatible (DeepSeek, Z.AI, MiniMax, MIMO...) ---
LLM_API_KEY=your_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# --- Tuỳ chọn 2: Anthropic trực tiếp (cần: uv add langchain-anthropic) ---
# ANTHROPIC_API_KEY=sk-ant-xxx
# ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Tuỳ chọn 3: OpenAI trực tiếp ---
# OPENAI_API_KEY=sk-xxx
# OPENAI_MODEL=gpt-4o

# --- Tuỳ chọn 4: OpenRouter (truy cập 300+ model) ---
# OPENROUTER_API_KEY=sk-or-xxx
# OPENROUTER_MODEL=anthropic/claude-sonnet-4-5

# =============================================================================
REGISTRY_URL=http://localhost:10000
